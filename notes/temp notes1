/**
 * @param {number[]} nums
 * @param {number} target
 * @return {number[]}
 */
var twoSum = function(nums, target) {
    const map = new Map();

    for(let i = 0; i < nums.length; i++){
        let num = nums[i];
        let complement = target - num;

        if(map.has(complement)){
            return[map.get(complement), i];
        }

        map.set(num, i);
    }

};

